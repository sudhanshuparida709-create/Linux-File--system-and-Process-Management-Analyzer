```gitignore
# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Next.js
.next/
frontend/.next/
out/
frontend/out/

# Build output
dist/
build/
coverage/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.local.example

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
env/
ENV/

# TypeScript
*.tsbuildinfo
frontend/*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# IDE and editor
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/

# Test artifacts
.nyc_output/
playwright-report/
test-results/

# Docker
*.pid
